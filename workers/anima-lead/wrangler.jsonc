{
  "name": "anima-lead",
  "main": "src/index.js",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "vars": {
    "TENANT": "anima-coffee",
    "DELIVERY_ENABLED": "false",
    "ALLOWED_ORIGINS": "https://aeo.animacoffee.com.ua,https://animacoffee.com.ua"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "anima-leads",
      "database_id": "REPLACE_WITH_ANIMA_D1_ID"
    }
  ],
  "ratelimits": [
    {
      "name": "INTAKE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
